# Variáveis de ambiente do Backend — Urna NGV

# Banco de dados
DATABASE_URL="postgresql://urna_admin:urna_secret@localhost:5432/urna_ngv"

# JWT
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE_AQUI"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3001
NODE_ENV=development

# CORS — URL do frontend
FRONTEND_URL="http://localhost:5173"

# Upload de fotos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Sessão abandonada: horas até expirar uma sessão EM_VOTACAO
SESSION_TIMEOUT_HOURS=2

# Admin inicial (usado no seed)
ADMIN_EMAIL="admin@urna.ngv"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"
